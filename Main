import time
seed(time.time())
Hit = Group(Rect(100, 250, 50, 50, fill='lightGreen'), Label("Hit", 125, 275))
Stand = Group(Rect(250, 250, 50, 50, fill='pink'), Label("Stand", 275, 275))
playAgain = Group(Rect(150, 350, 100, 50, fill='violet'), Label("Play Again?", 200, 375))
deck = []
playerHand = []
app.Stun = False
app.dealerTurn = False
playerHandVis = Label("", 200, 320, size = 18)
dealerHand = []
dealerHandVis = Label("", 200, 20, size = 18)
playerScore = Label("",10, 390, size = 18)
dealerScore = Label("",10, 10, size = 18)
winLose = Label ("", 200, 200, size = 35)

playAgain.opacity = 0

def fillDeck():
    var = 0
    while var < 52:
        deck.append(var)
        var += 1

def giveCards(list):
    randIndex = randrange(0, len(deck))
    list.append(deck[randIndex])
    deck.pop(randIndex)

def defCard(list, vis):
    suit = 0
    rank = 0
    vis.value = ''
    for card in list:
        if card//13 == 0:
            suit = "D"
        elif card//13 == 1:
            suit = "S"
        elif card//13 == 2:
            suit = "C"
        elif card//13 == 3:
            suit = "H"
        if card % 13 == 12:
            rank = "K"
        elif card % 13 == 11:
            rank = "Q"
        elif card % 13 == 10:
            rank = "J"
        elif card % 13 == 0:
            rank = "A"
        else:
            rank = (card % 13) + 1
        if list == dealerHand and dealerHand[0] == card and app.dealerTurn == False:
            vis.value = f" {vis.value} ???"
        else:
            vis.value = f" {vis.value} {rank}{suit}"

def Score(list):
    totalScore = 0
    Aces = 0
    acesUsed = 0
    for aces in list:
        if aces % 13 == 0:
            Aces += 1
    print(Aces)
    
    for id in list:
        if id % 13 == 12 or id % 13 == 11 or id % 13 == 10:
             totalScore += 10
        elif id % 13 == 0:
            totalScore += 11
        else:
            totalScore += (id % 13) + 1
    
    while totalScore > 21:
        if Aces - acesUsed > 0:
            totalScore -= 10
            acesUsed += 1
        else:
            break
    print(totalScore)
    return totalScore
def findWinner():
    app.Stun = True
    if Score(dealerHand) > 21 and not Score(playerHand) > 21:
        winLose.value = "Win"
    elif Score(playerHand) > 21 and not Score(dealerHand) > 21:
        winLose.value = "Lose"
    else:
        if Score(playerHand) > Score(dealerHand):
            winLose.value = "Win"
        else:
            winLose.value = "Lose"
    playAgain.opacity = 100
    
def Visuals(vis, list):
    vis.value = Score(list)

def Dealer():
    Visuals(dealerScore, dealerHand)
    defCard(dealerHand, dealerHandVis)
    while Score(dealerHand) < 17:
        giveCards(dealerHand)
        defCard(dealerHand, dealerHandVis)
        Visuals(dealerScore, dealerHand)
    findWinner()
def onMousePress(mouseX, mouseY):
    if Hit.hitTest(mouseX, mouseY) and app.Stun == False:
        print('Hit')
        giveCards(playerHand)
        defCard(playerHand, playerHandVis)
        Visuals(playerScore, playerHand)
        if Score(playerHand) > 21:
            findWinner()
    elif Stand.hitTest(mouseX, mouseY):
        print('Stand')
        app.dealerTurn = True
        Dealer()
    elif playAgain.hitTest(mouseX, mouseY):
        deck.clear()
        playerHand.clear()
        app.Stun = False
        app.dealerTurn = False
        playerHandVis.value = ""
        dealerHand.clear()
        dealerHandVis.value = ""
        playerScore.value = ""
        dealerScore.value = ""
        winLose.value = ""
        fillDeck()
        giveCards(playerHand)
        giveCards(playerHand)
        defCard(playerHand, playerHandVis)
        giveCards(dealerHand)
        giveCards(dealerHand)
        defCard(dealerHand, dealerHandVis)
        Visuals(playerScore, playerHand)
        playAgain.opacity = 0

fillDeck()
giveCards(playerHand)
giveCards(playerHand)
defCard(playerHand, playerHandVis)
giveCards(dealerHand)
giveCards(dealerHand)
defCard(dealerHand, dealerHandVis)
Visuals(playerScore, playerHand)
