import time
seed(time.time())
Hit = Group(Rect(100, 250, 50, 50, fill='lightGreen'), Label("Hit", 125, 275))
Stand = Group(Rect(250, 250, 50, 50, fill='pink'), Label("Stand", 275, 275))
deck = []
playerHand = []
playerHandVis = Label("", 200, 320, size=18)
dealerHand = []
dealerHandVis = Label("", 200, 20, size=18)
def fillDeck():
    var = 0
    while var < 52:
        deck.append(var)
        var += 1

def giveCards(list):
    randIndex = randrange(0, len(deck))
    list.append(deck[randIndex])
    deck.pop(randIndex)

def defCard(list, vis):
    suit = 0
    rank = 0
    vis.value = ''
    for card in list:
        if card//13 == 0:
            suit = "D"
        elif card//13 == 1:
            suit = "S"
        elif card//13 == 2:
            suit = "C"
        elif card//13 == 3:
            suit = "H"
        if card % 13 == 12:
            rank = "K"
        elif card % 13 == 11:
            rank = "Q"
        elif card % 13 == 10:
            rank = "J"
        elif card % 13 == 0:
            rank = "A"
        else:
            rank = (card % 13) + 1
        if list == dealerHand and dealerHand[0] == card:
            vis.value = f" {vis.value} ???"
        else:
            vis.value = f" {vis.value} {rank}{suit}"
        
fillDeck()
giveCards(playerHand)
giveCards(playerHand)
defCard(playerHand, playerHandVis)
giveCards(dealerHand)
giveCards(dealerHand)
defCard(dealerHand, dealerHandVis)

def onMousePress(mouseX, mouseY):
    if Hit.hitTest(mouseX, mouseY):
        print('Hit')
        giveCards(playerHand)
        defCard(playerHand, playerHandVis)
    elif Stand.hitTest(mouseX, mouseY):
        print('Stand')
