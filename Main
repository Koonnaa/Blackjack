import time
seed(time.time())
Hit = Group(Rect(100, 250, 50, 50, fill='lightGreen'), Label("Hit", 125, 275))
Stand = Group(Rect(250, 250, 50, 50, fill='pink'), Label("Stand", 275, 275))
deck = []
playerHand = []
app.Stun = False
playerHandVis = Label("", 200, 320, size = 18)
dealerHand = []
dealerHandVis = Label("", 200, 20, size = 18)
playerScore = Label("",10, 390)
winLose = Label ("", 200, 200, size = 35)
def fillDeck():
    var = 0
    while var < 52:
        deck.append(var)
        var += 1

def giveCards(list):
    randIndex = randrange(0, len(deck))
    list.append(deck[randIndex])
    deck.pop(randIndex)

def defCard(list, vis):
    suit = 0
    rank = 0
    vis.value = ''
    for card in list:
        if card//13 == 0:
            suit = "D"
        elif card//13 == 1:
            suit = "S"
        elif card//13 == 2:
            suit = "C"
        elif card//13 == 3:
            suit = "H"
        if card % 13 == 12:
            rank = "K"
        elif card % 13 == 11:
            rank = "Q"
        elif card % 13 == 10:
            rank = "J"
        elif card % 13 == 0:
            rank = "A"
        else:
            rank = (card % 13) + 1
        if list == dealerHand and dealerHand[0] == card:
            vis.value = f" {vis.value} ???"
        else:
            vis.value = f" {vis.value} {rank}{suit}"

def Score(list, vis):
    totalScore = 0
    Aces = 0
    acesUsed = 0
    for aces in list:
        if aces % 13 == 0:
            Aces += 1
    print(Aces)
    
    for id in list:
        if id % 13 == 12 or id % 13 == 11 or id % 13 == 10:
             totalScore += 10
        elif id % 13 == 0:
            totalScore += 11
        else:
            totalScore += (id % 13) + 1
    
    while totalScore > 21:
        if Aces - acesUsed > 0:
            totalScore -= 10
            acesUsed += 1
        else:
            winLose.value = "lost..."
            app.Stun = True
            break
    vis.value = totalScore
    print(totalScore)

fillDeck()
giveCards(playerHand)
giveCards(playerHand)
defCard(playerHand, playerHandVis)
giveCards(dealerHand)
giveCards(dealerHand)
defCard(dealerHand, dealerHandVis)
Score(playerHand, playerScore)

def onMousePress(mouseX, mouseY):
    if Hit.hitTest(mouseX, mouseY) and app.Stun == False:
        print('Hit')
        giveCards(playerHand)
        defCard(playerHand, playerHandVis)
        Score(playerHand, playerScore)
    elif Stand.hitTest(mouseX, mouseY):
        print('Stand')
